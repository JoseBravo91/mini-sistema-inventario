{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "InventarioDb": "Host=localhost;Port=5432;Database=inventario_db;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Emisor": "InventarioApi",
    "Audiencia": "InventarioApiClientes",
    "MinutosExpiracion": 60
  },
  "Cors": {
    "FrontendOrigin": "http://localhost:4200"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
